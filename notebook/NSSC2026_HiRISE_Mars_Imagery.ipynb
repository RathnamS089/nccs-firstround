        "    # def forward(self, x): # x [B,C,H,W]\n",
        "        # B,C,H,W=x.shape\n",
        "        # flat=x.permute(0,2,3,1).contiguous().view(-1, C)\n",
        "        # dist=torch.sum(flat**2,1,keepdim=True)+torch.sum(self.embedding.weight**2,1)-2*flat@self.embedding.weight.t()\n",
        "        # idx=torch.argmin(dist,1).unsqueeze(1)\n",
        "        # enc=torch.zeros(idx.size(0), self.embedding.num_embeddings, device=x.device).scatter_(1, idx, 1)\n",
        "        # quant=(enc@self.embedding.weight).view(B,H,W,C).permute(0,3,1,2).contiguous()\n",
        "        # loss=F.mse_loss(quant.detach(), x)+self.commitment*F.mse_loss(quant, x.detach())\n",
        "        # quant=x+(quant-x).detach()\n",
