        "import torch\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import cv2\n",
        "from sklearn.metrics import roc_auc_score, classification_report\n",
        "from torchvision import transforms\n",
        "from PIL import Image\n",
        "\n",
        "# 1. Load Test Metadata\n",
        "test_df = pd.read_csv(\"dataset/labels.csv\")\n",
        "test_df = test_df[test_df['split'] == 'test'].reset_index(drop=True)\n",
        "\n",
        "model.eval()\n",
        "anomaly_scores = []\n",
        "y_true = []\n",
        "\n",
        "transform = transforms.Compose([\n",
        "    transforms.Resize((128, 128)),\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "# 2. Run Inference\n",
        "fig, axes = plt.subplots(6, 3, figsize=(12, 18))\n",
        "plt.suptitle(\"VQ-VAE Anomaly Detection Results\\n(Original | Reconstruction | Residual Heatmap)\", fontsize=16)\n",
        "\n",
        "plot_count = 0\n",
        "\n",
        "with torch.no_grad():\n",
        "    for idx, row in test_df.iterrows():\n",
        "        img_path = f\"dataset/test/{row['filename']}\"\n",
        "        label = row['label']\n",
        "\n",
        "        orig_pil = Image.open(img_path).convert(\"RGB\")\n",
        "        img_tensor = transform(orig_pil).unsqueeze(0).to(device)\n",
        "\n",
        "        # Forward pass\n",
        "        _, recon_tensor = model(img_tensor)\n",
        "\n",
        "        # Calculate Anomaly Score (Mean Squared Error)\n",
        "        diff = torch.abs(img_tensor - recon_tensor)\n",
        "        score = torch.mean(diff).item()\n",
        "\n",
        "        anomaly_scores.append(score)\n",
        "        y_true.append(label)\n",
        "\n",
        "        # Save visual samples for the report (3 normal, 3 anomalous)\n",
        "        if plot_count < 6 and ((plot_count < 3 and label == 0) or (plot_count >= 3 and label == 1)):\n",
        "            orig_np = img_tensor.squeeze().cpu().permute(1, 2, 0).numpy()\n",
        "            recon_np = recon_tensor.squeeze().cpu().permute(1, 2, 0).numpy()\n",
        "            diff_np = diff.squeeze().cpu().mean(dim=0).numpy() # Grayscale residual map\n",
        "\n",
        "            # Plot Original\n",
        "            axes[plot_count, 0].imshow(orig_np)\n",
        "            axes[plot_count, 0].set_title(f\"Original (Label: {label})\")\n",
        "            axes[plot_count, 0].axis('off')\n",
        "\n",
        "            # Plot Reconstruction\n",
        "            axes[plot_count, 1].imshow(recon_np)\n",
        "            axes[plot_count, 1].set_title(\"VQ-VAE Reconstruction\")\n",
        "            axes[plot_count, 1].axis('off')\n",
        "\n",
        "            # Plot Heatmap\n",
        "            heatmap = axes[plot_count, 2].imshow(diff_np, cmap='jet')\n",
        "            axes[plot_count, 2].set_title(f\"Residual Score: {score:.4f}\")\n",
        "            axes[plot_count, 2].axis('off')\n",
        "\n",
        "            plot_count += 1\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"anomaly_visualizations.png\", dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# 3. Calculate Final ROC-AUC Metric\n",
        "auc = roc_auc_score(y_true, anomaly_scores)\n",
        "print(f\"\\n==========================================\")\n",
        "print(f\"FINAL UNSUPERVISED ANOMALY ROC-AUC SCORE: {auc:.4f}\")\n",
        "print(f\"==========================================\")"
      ],
