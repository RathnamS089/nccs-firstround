        "import cv2\n",
        "import numpy as np\n",
        "import random\n",
        "import os\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Redefine add_synthetic_anamoly function locally with fixes\n",
        "def add_synthetic_anamoly(image):\n",
        "  h,w =image.shape[:2]\n",
        "  image_copy=image.copy()\n",
        "  anamoly_type=random.choice(['sensor_line','corrupted_crop','non_martian'])\n",
        "  if anamoly_type=='sensor_line':\n",
        "    # Fix 1: random.randint needs two arguments. Choose column from 0 up to w-8 (for max line width of 8).\n",
        "    col=random.randint(0, max(0, w-8))\n",
        "    # Fix 2: random.choice needs a sequence.\n",
        "    image_copy[:,col:col+random.randint(2,8)]=random.choice([0,255])\n",
        "  elif anamoly_type=='corrupted_crop':\n",
        "    # Fix 3: random.randint needs two arguments. Choose x,y from 1 up to (w-50) or (h-50), ensuring minimum 1.\n",
        "    x,y=random.randint(1, max(1, w-50)),random.randint(1, max(1, h-50))\n",
        "    noise=np.random.randint(0,256,(min(50,h-y),min(50,w-x),3),dtype=np.uint8)\n",
        "    image_copy[y:y+noise.shape[0], x:x+noise.shape[1]] = noise\n",
        "  elif anamoly_type=='non_martian':\n",
        "    # Fix 4: random.randint needs two arguments. Assuming 30 as the lower bound.\n",
        "    centre=(random.randint(30, max(31, w-30)), random.randint(30, max(31, h-30)))\n",
        "    cv2.circle(image_copy,centre,random.randint(10,20),(255,0,0),-1)\n",
        "\n",
        "  return image_copy\n",
        "\n",
        "for split in [\"train\",\"test\",\"val\"]:\n",
        "  os.makedirs(os.path.join(DEST_DIR,split),exist_ok=True)\n",
        "train_val, test_imgs = train_test_split(all_file, test_size=0.2, random_state=42)\n",
        "train_imgs, val_imgs = train_test_split(train_val, test_size=0.125, random_state=42)\n",
        "labels_data=[]\n",
        "for split_name,img_list in[(\"train\",train_imgs),(\"val\",val_imgs)]:\n",
        "  for i,img_path in enumerate(img_list):\n",
        "      filename=f\"{split_name}_{i}.jpg\"\n",
        "      dest_path = os.path.join(DEST_DIR, split_name, filename)\n",
        "      img = cv2.imread(img_path)\n",
        "      if img is not None:\n",
        "            cv2.imwrite(dest_path, img)\n",
        "            labels_data.append({'filename': filename, 'split': split_name, 'label': 0})\n",
        "for i,img_path in enumerate(test_imgs):\n",
        "   filename=f\"test_{i}.jpg\"\n",
        "   dest_path=os.path.join(DEST_DIR,'test',filename)\n",
        "   img=cv2.imread(img_path)\n",
        "   if img is None:\n",
        "      continue\n",
        "   if random.random()>0.5:\n",
        "      anamolous_img=add_synthetic_anamoly(img)\n",
        "      cv2.imwrite(dest_path,anamolous_img)\n",
        "      labels_data.append({'filename': filename, 'split': 'test', 'label': 1})\n",
        "   else:\n",
        "      cv2.imwrite(dest_path,img)\n",
        "      labels_data.append({'filename':filename,'split':'test','label':0})\n",
        "df=pd.DataFrame(labels_data)\n",
        "df.to_csv(os.path.join(DEST_DIR, 'labels.csv'), index=False)\n",
        "print(\"Data Preparation Complete! Created train/, validation/, test/ and labels.csv!\")"
